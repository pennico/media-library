# Copy to <install dir>/.env and fill in. No secrets here: passwords are files in secrets/.
ML_UID=1000                       # id -u of the install user
ML_GID=1000                       # id -g
OWNER_LOGIN=you@example.com       # your Tailscale login: the only one allowed to write
MEDIALIB_ORIGIN=https://server.your-tailnet.ts.net:8443   # the Tailscale Serve address you publish
CONSOLE_PASSWORD_FILE=./secrets/console-password          # deploy/make-password.py writes it
AGENT_CONSOLE_STATE=./state/no-passkeys                   # a folder with passkeys.json (agent-console), or an empty folder
SNAPSHOT_DIR=./snapshot                                   # Yamtrack + CWA copies for the importer (read-only)
READER_USER=reader                                        # login for reading apps (Readest); its password is secrets/reader.pw
# Joplin review notes feed (optional, ops/joplin-sync.sh): the Joplin sync folder, read-only, either
# inside a container (e.g. Nextcloud's data folder) or as a folder on this machine.
JOPLIN_SOURCE_CONTAINER=                                  # e.g. nextcloud (read with docker exec ... tar)
JOPLIN_SOURCE_USER=www-data                               # user inside that container
JOPLIN_SOURCE_PATH=                                       # the sync folder inside it
JOPLIN_SOURCE_DIR=                                        # or: the sync folder on this machine
JOPLIN_NOTEBOOK=Reviews
# Joplin To watch / To read lists (optional, ops/joplin-lists.sh, docs/INSTALL.md 6d): a headless Joplin client syncs
# with the same target as your Joplin apps and deletes the lines it took. Its password: secrets/joplin-webdav.pw.
JOPLIN_SYNC_TARGET=5                                      # 5 Nextcloud, 6 WebDAV: as in your Joplin apps
JOPLIN_WEBDAV_URL=                                        # the folder your apps sync to, as this login sees it
JOPLIN_WEBDAV_USER=
JOPLIN_LISTS_NOTEBOOK=                                    # only the notes in this notebook (empty: any)
JOPLIN_VERSION=3.7.1                                      # the Joplin CLI: never newer than your apps accept (6d)
# Optional: a "find this book" link for books with no ebook file yet; {q} becomes title + author.
BOOK_FIND_URL=
BOOK_FIND_LABEL=
